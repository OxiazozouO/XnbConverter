<?xml version="1.0" encoding="utf-8"?>
<!-- 全局包目录钉到 D 盘：C 盘紧张，而 dotnet build/test 默认会把拉下来的包堆在
     %USERPROFILE%\.nuget\packages（本机实测 2.0 GB）。这里显式指到 D:\nuget-cache，
     已有缓存也已经搬过去，构建不必重新下载。 -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="D:\nuget-cache" />
  </config>
</configuration>
