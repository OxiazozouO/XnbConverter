      "Action": "EditImage",
      "Target": "LooseSprites/FixtureIcon",
      "FromFile": "assets/icon.png",
      "PatchMode": "Overlay"
    },
    {
      "LogName": "10 i18n 展开",
      "Action": "EditData",
      "Target": "Strings/StringsFromCSFiles",
      "Entries": {
        "Fixture.Key": "{{i18n:fixturekey}}"
      }
    },
    {
      "LogName": "11 TextOperations",
      "Action": "EditData",
      "Target": "Data/mail",
      "Entries": {
        "fixture_txt": "A"
      },
      "TextOperations": [
        {
          "Operation": "Append",
          "Target": [
            "Entries",
            "fixture_txt"
          ],
          "Value": "B"
        }
      ]
    },
    {
      "LogName": "12 负例 Random",
