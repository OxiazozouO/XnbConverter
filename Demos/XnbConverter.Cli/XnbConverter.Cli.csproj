<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <ApplicationIcon>..\..\.resources\App.ico</ApplicationIcon>
        <StartupObject>XnbConverter.Cli.Program</StartupObject>
        <LangVersion>10</LangVersion>
        <IsTrimmable>false</IsTrimmable>
        <PublishSingleFile>false</PublishSingleFile>
        <Version>1.6.2</Version>
    </PropertyGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\..\XnbConverter.Core\XnbConverter.Core.csproj">
            <Private>True</Private>
        </ProjectReference>
    </ItemGroup>

    <!--
      替身程序集只该待在 xna-shim\ 子目录里。搁在输出根目录会被运行时的默认探测抢先命中，
      .config/custom dll 里放的真 MonoGame 就永远轮不上 —— 实测 xTile.dll 会因此加载失败。
      Core → Cli 的传递引用会把根目录那份抄过来，DestinationSubDirectory 管不住它，所以这里清掉。
    -->
    <Target Name="DropXnaShimFromOutputRoot" AfterTargets="CopyFilesToOutputDirectory">
        <ItemGroup>
            <XnaShimStray Include="$(OutDir)MonoGame.Framework.*" />
        </ItemGroup>
        <Delete Files="@(XnaShimStray)" ContinueOnError="true" />
    </Target>
</Project>
