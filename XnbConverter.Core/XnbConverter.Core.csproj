<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>XnbConverter</RootNamespace>
        <OutputType>Library</OutputType>
        <IsTrimmable>false</IsTrimmable>
        <!-- Utilities/LZ4 是 vendored 的 lz4net（见该目录 NOTICE.md），全是 unsafe 指针代码 -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Error.resx">
        <Generator>PublicResXFileCodeGenerator</Generator>
        <LastGenOutput>Error.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Error.de.resx">
        <DependentUpon>Error.resx</DependentUpon>
      </EmbeddedResource>
      <EmbeddedResource Update="Error.es.resx">
        <DependentUpon>Error.resx</DependentUpon>
      </EmbeddedResource>
      <EmbeddedResource Update="Error.fr.resx">
        <DependentUpon>Error.resx</DependentUpon>
      </EmbeddedResource>
      <EmbeddedResource Update="Error.hu.resx">
        <DependentUpon>Error.resx</DependentUpon>
      </EmbeddedResource>
      <EmbeddedResource Update="Error.it.resx">
        <DependentUpon>Error.resx</DependentUpon>
      </EmbeddedResource>
      <EmbeddedResource Update="Error.ja.resx">
        <DependentUpon>Error.resx</DependentUpon>
      </EmbeddedResource>
      <EmbeddedResource Update="Error.ko.resx">
        <DependentUpon>Error.resx</DependentUpon>
      </EmbeddedResource>
      <EmbeddedResource Update="Error.pt.resx">
        <DependentUpon>Error.resx</DependentUpon>
      </EmbeddedResource>
      <EmbeddedResource Update="Error.ru.resx">
        <DependentUpon>Error.resx</DependentUpon>
      </EmbeddedResource>
      <EmbeddedResource Update="Error.tr.resx">
        <DependentUpon>Error.resx</DependentUpon>
      </EmbeddedResource>
      <EmbeddedResource Update="Error.zh.resx">
        <DependentUpon>Error.resx</DependentUpon>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Error.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Error.resx</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <None Remove="Tbin\LICENSE" />
      <None Remove="Utilities\LibSquishNet\LICENSE" />
    </ItemGroup>

    <ItemGroup>
      <!--
        Point / Rectangle / Vector2 住在替身程序集里，所以这是实打实的编译期依赖。
        但它**不能落在输出目录根部** —— 那里会被运行时的默认探测抢先命中，
        .config/custom dll 里放的真 MonoGame 就永远轮不上了（实测：xTile.dll 这类需要更多
        MonoGame 类型的程序集会加载失败）。放进子目录，交给 RootPath 的解析兜底按优先级取。
      -->
      <ProjectReference Include="..\XnbConverter.XnaShim\XnbConverter.XnaShim.csproj">
        <DestinationSubDirectory>xna-shim\</DestinationSubDirectory>
      </ProjectReference>
    </ItemGroup>

</Project>
